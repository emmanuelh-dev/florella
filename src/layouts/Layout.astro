---
import "../styles/global.css";
import { getCategoriasSoloOfrendas } from "../data/catalogo.js";

const {
  title = "Florella · Florería en Monterrey",
  description = "Arreglos, bouquets y ofrendas con entrega el mismo día en Monterrey y área metropolitana. Pide por WhatsApp.",
  ogType = "website",
} = Astro.props;

const ruta = Astro.url.pathname;
const enSoloOfrendas = ruta.startsWith("/solo-ofrendas");

// Cada catálogo tiene su propia navegación.
const categoriasSolo = enSoloOfrendas ? await getCategoriasSoloOfrendas() : [];
const inicioHref = enSoloOfrendas ? "/solo-ofrendas" : "/";
const navegacion = enSoloOfrendas
  ? [
      { href: "/solo-ofrendas", texto: "Inicio", activo: ruta === "/solo-ofrendas" },
      ...categoriasSolo.map((cat) => ({
        href: `/solo-ofrendas/${cat.slug}`,
        texto: cat.nombre,
        activo: ruta === `/solo-ofrendas/${cat.slug}`,
      })),
    ]
  : [
      { href: "/", texto: "Inicio", activo: ruta === "/" },
      { href: "/solo-ofrendas", texto: "Solo Ofrendas", activo: false },
    ];

// SEO: URLs absolutas para canonical y Open Graph (Astro.site sale de astro.config).
const base = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, base).href;
const ogImagen = new URL("/imagenes/cabecera.jpg", base).href;

// Datos estructurados (schema.org) de la florería.
const negocio = {
  "@context": "https://schema.org",
  "@type": "Florist",
  name: "Florella Eventos y detalles",
  url: base.href,
  image: ogImagen,
  telephone: "+528142547600",
  areaServed: "Monterrey y área metropolitana",
  priceRange: "$$",
  address: { "@type": "PostalAddress", addressLocality: "Monterrey", addressRegion: "NL", addressCountry: "MX" },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18532000410"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-18532000410');
    </script>
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "z2e7cyheo6");
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#8F4359" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / redes sociales -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Florella" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImagen} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImagen} />

    <!-- Datos estructurados -->
    <script type="application/ld+json" set:html={JSON.stringify(negocio)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:rounded-none focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-wine"
      >Saltar al contenido</a
    >

    <!-- SVG Icon Library -->
    <svg
      class="hidden"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <!-- Iconos: https://lucide.dev/icons -->
      <symbol id="i-heart" viewBox="0 0 24 24">
        <path
          d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"
        />
      </symbol>
      <symbol id="i-cart" viewBox="0 0 24 24">
        <path d="m2.05 2.05 1.099-.028a1 1 0 0 1 1.008.815l2.69 14.347A1 1 0 0 0 7.83 18H18" />
        <path d="M4.563 5h16.435a1 1 0 0 1 .981 1.204l-1.026 6.226A2 2 0 0 1 18.962 14H6.25" />
        <circle cx="18" cy="20" r="2" />
        <circle cx="8" cy="20" r="2" />
      </symbol>
      <symbol id="i-bag" viewBox="0 0 24 24">
        <path d="M16 10a4 4 0 0 1-8 0" />
        <path d="M3.103 6.034h17.794" />
        <path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z" />
      </symbol>
      <symbol id="i-arrow" viewBox="0 0 24 24">
        <path d="M5 12h14" />
        <path d="m12 5 7 7-7 7" />
      </symbol>
      <symbol id="i-close" viewBox="0 0 24 24">
        <path d="M18 6 6 18" />
        <path d="m6 6 12 12" />
      </symbol>
      <symbol id="i-plus" viewBox="0 0 24 24">
        <path d="M5 12h14" />
        <path d="M12 5v14" />
      </symbol>
      <symbol id="i-minus" viewBox="0 0 24 24">
        <path d="M5 12h14" />
      </symbol>
      <symbol id="i-check" viewBox="0 0 24 24">
        <path d="M20 6 9 17l-5-5" />
      </symbol>
      <symbol id="i-orchid" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="3" />
        <path
          d="M12 16.5A4.5 4.5 0 1 1 7.5 12 4.5 4.5 0 1 1 12 7.5a4.5 4.5 0 1 1 4.5 4.5 4.5 4.5 0 1 1-4.5 4.5"
        />
        <path d="M12 7.5V9" />
        <path d="M7.5 12H9" />
        <path d="M16.5 12H15" />
        <path d="M12 16.5V15" />
        <path d="m8 8 1.88 1.88" />
        <path d="M14.12 9.88 16 8" />
        <path d="m8 16 1.88-1.88" />
        <path d="M14.12 14.12 16 16" />
      </symbol>
      <symbol id="i-whatsapp" viewBox="0 0 24 24">
        <path
          d="M21 11.5a8.5 8.5 0 0 1-12.3 7.6L3 21l1.9-5.7A8.5 8.5 0 1 1 21 11.5Z"
        ></path>
        <path
          d="M8.8 7.9c.2-.4.4-.4.6-.4h.4c.2 0 .4 0 .5.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c-.1.1-.2.3 0 .5a6 6 0 0 0 2.8 2.4c.3.1.4.1.5-.1l.6-.7c.2-.2.3-.2.5-.1l1.5.8c.2.1.3.2.3.4 0 .8-.6 1.5-1.2 1.6-.6.1-1.2.1-3.2-.9a10 10 0 0 1-3.5-3.2c-.4-.8-.5-1.4-.4-1.9 0-.3.2-.7.5-1Z"
        ></path>
      </symbol>
      <symbol id="i-menu" viewBox="0 0 24 24">
        <path d="M4 5h16" />
        <path d="M4 12h16" />
        <path d="M4 19h16" />
      </symbol>
    </svg>

    <!-- Header Navbar -->
    <header
      class="sticky top-0 z-50 border-b border-line bg-white/95 backdrop-blur"
    >
      <div
        class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6"
      >
        <a
          href={inicioHref}
          aria-label="Florella, inicio"
          class="flex shrink-0 items-center"
        >
          <img
            src="/imagenes/logo.png"
            alt="Florella Eventos y detalles"
            class="h-10 w-auto object-contain sm:h-11"
          />
        </a>

        <nav
          aria-label="Navegación principal"
          class="hidden items-center gap-1 md:flex"
        >
          {
            navegacion.map((item) => (
              <a
                href={item.href}
                aria-current={item.activo ? "page" : undefined}
                class:list={[
                  "rounded-none px-3 py-2 text-[12px] font-semibold tracking-[0.1em] uppercase transition",
                  item.activo
                    ? "bg-wine-soft text-wine"
                    : "text-ink-secondary hover:bg-wine-soft/60 hover:text-wine",
                ]}
              >
                {item.texto}
              </a>
            ))
          }
          <button
            type="button"
            data-open-dialog="contact-dialog"
            class="cursor-pointer rounded-none bg-transparent px-3 py-2 text-[12px] font-semibold tracking-[0.1em] text-ink-secondary uppercase transition hover:bg-wine-soft/60 hover:text-wine"
            >Contacto</button
          >
        </nav>

        <div class="flex items-center gap-1 sm:gap-2">
          <button
            type="button"
            id="favorites-toggle"
            aria-label="Ver mis favoritos"
            aria-pressed="false"
            class="relative inline-flex h-10 w-10 items-center justify-center rounded-none text-ink-secondary transition hover:bg-wine-soft hover:text-wine"
          >
            <svg class="h-5 w-5" aria-hidden="true"
              ><use href="#i-heart"></use></svg
            >
          </button>
          <button
            type="button"
            data-open-dialog="cart-dialog"
            aria-label="Abrir carrito"
            class="relative inline-flex h-10 w-10 items-center justify-center rounded-none text-ink-secondary transition hover:bg-wine-soft hover:text-wine"
          >
            <svg class="h-5 w-5" aria-hidden="true"
              ><use href="#i-cart"></use></svg
            >
            <span
              data-cart-count
              aria-hidden="true"
              class="absolute -top-0.5 -right-0.5 flex h-5 min-w-5 items-center justify-center rounded-none bg-wine-badge px-1 text-[11px] font-semibold text-white"
              >0</span
            >
          </button>
          <button
            type="button"
            data-open-dialog="menu-dialog"
            aria-label="Abrir menú"
            class="relative inline-flex h-10 w-10 items-center justify-center rounded-none text-ink-secondary transition hover:bg-wine-soft hover:text-wine md:hidden"
          >
            <svg class="h-5 w-5" aria-hidden="true"
              ><use href="#i-menu"></use></svg
            >
          </button>
        </div>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-line bg-white">
      <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
        <div
          class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center"
        >
          <a
            href="/"
            aria-label="Florella, volver al inicio"
            class="flex shrink-0 items-center"
          >
            <img
              src="/imagenes/logo.png"
              alt="Florella Eventos y detalles"
              class="h-10 w-auto object-contain sm:h-11"
            />
          </a>
          <nav
            aria-label="Navegación pie de página"
            class="flex flex-wrap items-center gap-4 text-sm text-muted"
          >
            <a href="/" class="transition hover:text-wine">Inicio</a>
            <a href="/solo-ofrendas" class="transition hover:text-wine"
              >Solo Ofrendas</a
            >
            <button
              type="button"
              data-open-dialog="contact-dialog"
              class="cursor-pointer bg-transparent transition hover:text-wine"
              >Contacto</button
            >
          </nav>
        </div>
        <div
          class="mt-6 flex flex-col gap-1 border-t border-line pt-4 text-xs text-muted sm:flex-row sm:items-center sm:justify-between"
        >
          <p>© 2026 Florella. Todos los derechos reservados.</p>
          <span
            >Entrega express en Monterrey y zona conurbada · WhatsApp 81 1617
            6724.</span
          >
        </div>
      </div>
    </footer>

    <!-- WhatsApp flotante: abre la solicitud con el formulario -->
    <button
      id="floating-order"
      type="button"
      data-open-dialog="cart-dialog"
      aria-label="Pedir por WhatsApp"
      class="fixed right-4 bottom-4 z-[80] inline-flex items-center gap-2 rounded-none bg-wine px-4 py-3 text-sm font-semibold text-white shadow-lg transition hover:bg-wine-hover"
    >
      <svg class="h-5 w-5" aria-hidden="true"><use href="#i-whatsapp"></use></svg>
      <span class="hidden sm:inline">Pedir por WhatsApp</span>
    </button>

    <!-- Cart Drawer -->
    <dialog
      id="cart-dialog"
      aria-labelledby="cart-title"
      class="m-0 top-0 right-0 bottom-0 left-auto h-dvh max-h-none w-[min(92vw,430px)] max-w-none translate-x-full overflow-y-auto rounded-none border-l border-line bg-white p-0 text-ink shadow-[-24px_0_60px_-20px_rgba(0,0,0,0.45)] backdrop:bg-black/50 transition-transform duration-300 ease-out open:translate-x-0 starting:open:translate-x-full"
    >
      <div class="h-1 w-full bg-wine"></div>
      <div
        class="sticky top-0 z-10 flex items-start justify-between gap-4 border-b border-line bg-white px-6 py-5"
      >
        <div>
          <span
            class="text-[10px] font-semibold tracking-[0.28em] text-wine uppercase"
            >PEDIDO ESPECIAL</span
          >
          <h2
            id="cart-title"
            class="mt-1.5 font-serif text-[26px] leading-none font-semibold text-ink"
          >
            Tu carrito
          </h2>
        </div>
        <button
          type="button"
          data-close-dialog
          aria-label="Cerrar carrito"
          class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-none text-ink-secondary transition hover:border-wine hover:text-wine"
        >
          <svg class="h-4 w-4" aria-hidden="true"
            ><use href="#i-close"></use></svg
          >
        </button>
      </div>

      <div id="empty-cart" class="px-6 py-12 text-center">
        <svg class="mx-auto block h-9 w-9 text-muted-light" aria-hidden="true"
          ><use href="#i-bag"></use></svg
        >
        <h3 class="mt-4 mb-2 font-serif text-xl text-ink">
          Tu carrito está vacío.
        </h3>
        <p class="mb-6 text-[13px] leading-relaxed text-muted">
          Agrega una ofrenda para preparar tu solicitud.
        </p>
        <button
          type="button"
          data-close-dialog
          class="inline-flex items-center gap-2 rounded-none bg-wine px-6 py-3 text-[12px] font-semibold tracking-[0.1em] text-white uppercase transition hover:bg-wine-hover"
        >
          Explorar arreglos
        </button>
      </div>

      <div
        id="cart-items"
        class="flex flex-col gap-3 p-6"
      >
      </div>

      <div id="cart-summary" class="border-t border-line p-6">
        <div id="cart-subtotal" class="mb-5">
          <div
            class="flex items-center justify-between border-b border-line pb-3"
          >
            <span
              class="text-[11px] font-semibold tracking-[0.18em] text-ink-secondary uppercase"
              >Subtotal</span
            >
            <strong
              id="cart-total"
              class="font-serif text-xl font-semibold text-ink"
              >$0 MXN</strong
            >
          </div>
          <p class="mt-3 text-[11.5px] text-muted">
            Entrega en Monterrey y zona conurbada incluida según zona.
          </p>
        </div>

        <form id="order-form" class="mt-6 space-y-6">
          <p class="text-base font-semibold text-wine">
            Datos del pedido
          </p>
          <p class="text-sm text-muted">
            Datos opcionales. Puedes completarlos por WhatsApp.
          </p>

          <div class="grid grid-cols-1 gap-6">
            <label
              class="flex min-w-0 flex-col gap-2 text-sm font-medium text-ink-secondary"
            >
              Fecha de entrega
              <input
                type="date"
                name="fechaEntrega"
                class="min-w-0 w-full rounded-none bg-page px-3 py-2.5 text-sm text-ink outline-none transition focus:border-wine focus:ring-1 focus:ring-wine"
              />
            </label>
            <label
              class="flex min-w-0 flex-col gap-2 text-sm font-medium text-ink-secondary"
            >
              Horario de entrega
              <input
                type="text"
                name="rangoHorario"
                placeholder="10:00 – 13:00"
                class="min-w-0 w-full rounded-none bg-page px-3 py-2.5 text-sm text-ink outline-none transition focus:border-wine focus:ring-1 focus:ring-wine"
              />
            </label>
          </div>

          <label
            class="flex min-w-0 flex-col gap-2 text-sm font-medium text-ink-secondary"
          >
            Nombre del fallecido (+)
            <input
              type="text"
              name="fallecido"
              class="min-w-0 w-full rounded-none bg-page px-3 py-2.5 text-sm text-ink outline-none transition focus:border-wine focus:ring-1 focus:ring-wine"
            />
          </label>

          <label
            class="flex min-w-0 flex-col gap-2 text-sm font-medium text-ink-secondary"
          >
            Dirección o capilla
            <input
              type="text"
              name="direccion"
              autocomplete="off"
              maxlength="200"
              aria-describedby="address-status"
              aria-controls="address-results"
              class="min-w-0 w-full rounded-none bg-page px-3 py-2.5 text-sm text-ink outline-none transition focus:border-wine focus:ring-1 focus:ring-wine"
            />
          </label>
          <p id="address-status" role="status" class="text-sm text-ink-secondary"></p>
          <ul id="address-results" hidden aria-label="Direcciones encontradas" class="max-h-60 overflow-y-auto bg-white"></ul>

          <label class="flex min-w-0 flex-col gap-2 text-sm font-medium text-ink-secondary">
            Referencia o entrecalles
            <input
              type="text"
              name="referencia"
              maxlength="300"
              placeholder="Ej. Entre Roble y Pino, portón azul"
              class="min-w-0 w-full rounded-none bg-page px-3 py-2.5 text-sm text-ink outline-none transition focus:border-wine focus:ring-1 focus:ring-wine"
            />
          </label>

          <label
            class="flex min-w-0 flex-col gap-2 text-sm font-medium text-ink-secondary"
          >
            Texto en listón
            <input
              type="text"
              name="liston"
              placeholder="Ej. Siempre en nuestros corazones"
              class="min-w-0 w-full rounded-none bg-page px-3 py-2.5 text-sm text-ink outline-none transition focus:border-wine focus:ring-1 focus:ring-wine"
            />
          </label>

          <div class="grid grid-cols-1 gap-6">
            <label
              class="flex min-w-0 flex-col gap-2 text-sm font-medium text-ink-secondary"
            >
              Teléfono de contacto
              <input
                type="tel"
                name="telefono"
                inputmode="tel"
                placeholder="10 dígitos"
                class="min-w-0 w-full rounded-none bg-page px-3 py-2.5 text-sm text-ink outline-none transition focus:border-wine focus:ring-1 focus:ring-wine"
              />
            </label>
            <label
              class="flex min-w-0 flex-col gap-2 text-sm font-medium text-ink-secondary"
            >
              Horario de servicio
              <input
                type="text"
                name="horarioServicio"
                placeholder="09:00 – 18:00"
                class="min-w-0 w-full rounded-none bg-page px-3 py-2.5 text-sm text-ink outline-none transition focus:border-wine focus:ring-1 focus:ring-wine"
              />
            </label>
          </div>

          <label
            class="flex min-w-0 flex-col gap-2 text-sm font-medium text-ink-secondary"
          >
            Diseño y colores
            <textarea
              name="fotoColores"
              rows="2"
              placeholder="Describe la ofrenda y los colores. Adjunta la foto en el chat de WhatsApp."
              class="min-w-0 w-full rounded-none bg-page px-3 py-2.5 text-sm text-ink outline-none transition focus:border-wine focus:ring-1 focus:ring-wine"
            ></textarea>
          </label>

          <button
            id="checkout"
            type="submit"
            class="flex w-full items-center justify-center gap-2 rounded-none bg-wine px-5 py-3.5 text-[13px] font-semibold tracking-[0.08em] text-white uppercase transition hover:bg-wine-hover disabled:opacity-50"
          >
            Enviar solicitud por WhatsApp <svg
              class="h-4 w-4"
              aria-hidden="true"><use href="#i-arrow"></use></svg
            >
          </button>
          <p class="text-[11px] text-muted">
            Se abrirá WhatsApp con los datos. Adjunta ahí la foto de referencia.
          </p>
        </form>

        <!-- Cerrar el carrito (siempre visible, sin tener que subir) -->
        <button
          type="button"
          data-close-dialog
          class="mt-3 flex w-full items-center justify-center gap-2 rounded-none bg-white px-5 py-3 text-[12px] font-semibold tracking-[0.08em] text-ink uppercase transition hover:border-wine hover:text-wine"
        >
          <svg class="h-4 w-4" aria-hidden="true"><use href="#i-close"></use></svg>
          Cerrar carrito
        </button>
      </div>
    </dialog>

    <!-- Cart Item Template -->
    <template id="cart-item-template">
      <article
        class="flex items-start gap-3 rounded-none bg-white p-3"
      >
        <img
          width="72"
          height="72"
          alt=""
          class="h-[72px] w-[72px] shrink-0 rounded-none object-cover"
        />
        <div class="flex min-w-0 flex-1 flex-col gap-1">
          <h3 class="truncate text-sm font-semibold text-ink"></h3>
          <p data-cart-price class="text-[13px] font-bold text-wine"></p>
          <div
            class="inline-flex w-fit items-center gap-1.5 rounded-none px-1.5 py-1"
          >
            <button
              type="button"
              data-cart-action="decrease"
              aria-label="Disminuir cantidad"
              class="inline-flex h-6 w-6 items-center justify-center rounded-none text-ink transition hover:bg-wine-soft hover:text-wine"
            >
              <svg class="h-3.5 w-3.5" aria-hidden="true"
                ><use href="#i-minus"></use></svg
              >
            </button>
            <span data-quantity class="text-[13px] font-semibold text-ink"
              >1</span
            >
            <button
              type="button"
              data-cart-action="increase"
              aria-label="Aumentar cantidad"
              class="inline-flex h-6 w-6 items-center justify-center rounded-none text-ink transition hover:bg-wine-soft hover:text-wine"
            >
              <svg class="h-3.5 w-3.5" aria-hidden="true"
                ><use href="#i-plus"></use></svg
              >
            </button>
          </div>
        </div>
        <button
          type="button"
          data-cart-action="remove"
          aria-label="Eliminar producto"
          class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-none text-muted transition hover:border-wine hover:text-wine"
        >
          <svg class="h-4 w-4" aria-hidden="true"
            ><use href="#i-close"></use></svg
          >
        </button>
      </article>
    </template>

    <!-- Ficha del arreglo (se abre al tocar la foto) -->
    <dialog
      id="product-dialog"
      aria-labelledby="product-title"
      class="relative m-auto max-h-[92dvh] w-[min(94vw,860px)] overflow-y-auto rounded-none bg-white p-0 text-ink shadow-2xl backdrop:bg-black/50"
    >
      <button
        type="button"
        data-close-dialog
        aria-label="Cerrar ficha"
        class="absolute top-3 right-3 z-10 inline-flex h-10 w-10 items-center justify-center rounded-none bg-white/90 text-ink-secondary shadow-sm backdrop-blur transition hover:text-wine"
      >
        <svg class="h-5 w-5" aria-hidden="true"
          ><use href="#i-close"></use></svg
        >
      </button>
      <div class="grid sm:grid-cols-2">
        <div class="aspect-[3/4] bg-white">
          <img data-product-image alt="" class="h-full w-full object-cover" />
        </div>
        <div class="flex flex-col gap-4 p-6 sm:p-8">
          <span
            class="text-[10px] font-semibold tracking-[0.28em] text-wine uppercase"
            >Florella</span
          >
          <h2
            id="product-title"
            data-product-name
            class="font-serif text-2xl leading-tight font-semibold text-ink sm:text-3xl"
          >
          </h2>
          <p
            data-product-price
            class="font-serif text-xl font-semibold text-wine"
          >
          </p>
          <p
            data-product-description
            class="text-sm leading-relaxed whitespace-pre-line text-muted"
          >
          </p>
          <button
            type="button"
            data-add-product
            class="mt-auto inline-flex items-center justify-center gap-2 rounded-none bg-wine px-6 py-3 text-[12px] font-semibold tracking-[0.1em] text-white uppercase transition hover:bg-wine-hover"
          >
            <svg class="h-4 w-4" aria-hidden="true"
              ><use href="#i-bag"></use></svg
            >
            Agregar al carrito
          </button>
          <p class="text-[11px] text-muted">
            Entrega en Monterrey y área metropolitana. Pide por WhatsApp.
          </p>
        </div>
      </div>
    </dialog>

    <!-- Menú (móvil) -->
    <dialog
      id="menu-dialog"
      aria-labelledby="menu-title"
      class="m-0 top-0 bottom-0 left-0 right-auto h-dvh max-h-none w-[min(80vw,320px)] max-w-none -translate-x-full overflow-y-auto rounded-none border-r border-line bg-white p-0 text-ink shadow-[24px_0_60px_-20px_rgba(0,0,0,0.45)] backdrop:bg-black/50 transition-transform duration-300 ease-out open:translate-x-0 starting:open:-translate-x-full"
    >
      <div class="h-1 w-full bg-wine"></div>
      <div class="flex items-center justify-between border-b border-line px-6 py-5">
        <span
          id="menu-title"
          class="text-[10px] font-semibold tracking-[0.28em] text-wine uppercase"
          >Menú</span
        >
        <button
          type="button"
          data-close-dialog
          aria-label="Cerrar menú"
          class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-none text-ink-secondary transition hover:border-wine hover:text-wine"
        >
          <svg class="h-4 w-4" aria-hidden="true"
            ><use href="#i-close"></use></svg
          >
        </button>
      </div>
      <nav aria-label="Menú" class="flex flex-col p-4">
        {
          navegacion.map((item) => (
            <a
              href={item.href}
              aria-current={item.activo ? "page" : undefined}
              class="border-b border-line px-2 py-4 text-[13px] font-semibold tracking-[0.1em] text-ink uppercase transition hover:text-wine"
            >
              {item.texto}
            </a>
          ))
        }
        <button
          type="button"
          data-open-dialog="contact-dialog"
          class="px-2 py-4 text-left text-[13px] font-semibold tracking-[0.1em] text-ink uppercase transition hover:text-wine"
          >Contacto</button
        >
      </nav>
      <div class="px-4 pb-6">
        <a
          href="https://wa.me/528142547600"
          target="_blank"
          rel="noopener"
          class="inline-flex w-full items-center justify-center gap-2 rounded-none bg-wine px-5 py-3 text-[12px] font-semibold tracking-[0.1em] text-white uppercase transition hover:bg-wine-hover"
        >
          <svg class="h-5 w-5" aria-hidden="true"
            ><use href="#i-whatsapp"></use></svg
          >
          WhatsApp
        </a>
      </div>
    </dialog>

    <!-- Contact Dialog -->
    <dialog
      id="contact-dialog"
      aria-labelledby="contact-title"
      class="relative m-auto w-[min(94vw,520px)] rounded-none bg-white p-6 text-left text-ink shadow-2xl backdrop:bg-black/50 sm:p-8"
    >
      <button
        type="button"
        data-close-dialog
        aria-label="Cerrar contacto"
        class="absolute top-3 right-3 inline-flex h-10 w-10 items-center justify-center rounded-none text-ink-secondary transition hover:bg-wine-soft hover:text-wine"
      >
        <svg class="h-5 w-5" aria-hidden="true"><use href="#i-close"></use></svg
        >
      </button>
      <span class="text-[11px] font-semibold tracking-[0.22em] text-wine"
        >ATENCIÓN INMEDIATA 24/7</span
      >
      <h2
        id="contact-title"
        class="mt-2 font-serif text-3xl font-semibold text-ink"
      >
        Estamos para apoyarte
      </h2>
      <p id="contact-copy" class="mt-3 text-sm leading-relaxed text-muted">
        Comunícate directamente con nosotros para coordinar la entrega o
        personalizar la cinta con el mensaje de condolencias.
      </p>
      <a
        href="https://api.whatsapp.com/send?phone=528116176724&text=Hola,%20necesito%20informaci%C3%B3n%20sobre%20un%20arreglo%20funerario"
        target="_blank"
        rel="noopener"
        class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-none bg-wine px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-wine-hover"
      >
        Escribir por WhatsApp <svg class="h-4 w-4" aria-hidden="true"
          ><use href="#i-arrow"></use></svg
        >
      </a>
    </dialog>

    <div id="continue-order" hidden>
      <div class="h-24" aria-hidden="true"></div>
      <div class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-white p-4 pb-[max(1rem,env(safe-area-inset-bottom))]">
        <button
          type="button"
          data-open-dialog="cart-dialog"
          class="flex w-full items-center justify-center gap-2 rounded-none bg-wine px-5 py-3 text-sm font-semibold text-white transition hover:bg-wine-hover"
        >
          <svg class="h-5 w-5" aria-hidden="true"><use href="#i-cart"></use></svg>
          Continuar pedido
          <svg class="h-5 w-5" aria-hidden="true"><use href="#i-arrow"></use></svg>
        </button>
      </div>
    </div>

    <!-- Toast Notification -->
    <div
      id="toast"
      role="status"
      aria-live="polite"
      hidden
      class="fixed bottom-[calc(6rem+env(safe-area-inset-bottom))] left-1/2 z-[90] w-max max-w-[92vw] -translate-x-1/2 overflow-hidden rounded-none bg-ink px-4 py-2.5 text-sm font-medium text-ellipsis whitespace-nowrap text-white shadow-lg"
    >
      <svg class="mr-1.5 inline h-4 w-4" aria-hidden="true"
        ><use href="#i-check"></use></svg
      >
      <span></span>
    </div>

    <!-- Scripts -->
    <script is:inline defer src="/scripts/config.js"></script>
    <script is:inline defer src="/scripts/tienda.js"></script>
    <script is:inline defer src="/scripts/direcciones.js"></script>
    <script is:inline>
      // Marca visual de la categoría activa en los círculos de categorías.
      document.addEventListener("DOMContentLoaded", () => {
        const catButtons = document.querySelectorAll("[data-occasion]");
        catButtons.forEach((btn) => {
          btn.addEventListener("click", () => {
            catButtons.forEach((b) => {
              b.dataset.active = "false";
            });
            btn.dataset.active = "true";
          });
        });
      });
    </script>
  </body>
</html>
