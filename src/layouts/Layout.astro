    <!-- Scripts -->
    <script is:inline defer src="/scripts/config.js"></script>
    <script is:inline defer src="/scripts/tienda.js"></script>
    <script is:inline>
      // Marca visual de la categoría activa en los círculos de categorías.
      document.addEventListener("DOMContentLoaded", () => {
        const catButtons = document.querySelectorAll("[data-occasion]");
        catButtons.forEach((btn) => {
          btn.addEventListener("click", () => {
            catButtons.forEach((b) => {
              b.dataset.active = "false";
            });
            btn.dataset.active = "true";
          });
        });
      });
