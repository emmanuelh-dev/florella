---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCategoriasSoloOfrendas } from '../../data/catalogo.js';

const categorias = await getCategoriasSoloOfrendas();
const total = categorias.reduce((n, cat) => n + cat.productos.length, 0);
---

<Layout
  title="Solo Ofrendas · Florella"
  description="Catálogo Solo Ofrendas: arreglos fúnebres, coronas y canastillas de peregrinación con entrega en Monterrey."
>
  <section class="bg-page py-10 sm:py-14">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <span class="text-[11px] font-semibold tracking-[0.24em] text-wine uppercase"
        >Catálogo</span
      >
      <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
        <h1
          class="font-serif text-3xl font-semibold text-ink sm:text-4xl lg:text-5xl"
        >
          Solo Ofrendas
        </h1>
        <p
          class="text-[12px] font-semibold tracking-[0.12em] text-muted uppercase"
        >
          {total} arreglos · {categorias.length} categorías
        </p>
      </div>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted sm:text-base">
        Todo el catálogo, reunido. Filtra por categoría o agrega tus ofrendas y
        envía tu solicitud por WhatsApp. Entrega en Monterrey y zona conurbada.
      </p>

      <!-- Nav de categorías: cada una lleva a su página -->
      <nav aria-label="Categorías" class="mt-6 flex flex-wrap gap-1.5">
        {
          categorias.map((cat) => (
            <a
              href={`/solo-ofrendas/${cat.slug}`}
              class="rounded-none border border-line bg-white px-3 py-1.5 text-[12px] font-semibold tracking-[0.06em] text-ink-secondary uppercase transition hover:border-wine hover:text-wine"
            >
              {cat.nombre}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  {
    categorias.map((cat, i) => (
      <section class="border-t border-line bg-page py-10 sm:py-12">
        <div class="mx-auto max-w-6xl px-4 sm:px-6">
          <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
            <div>
              <span class="text-[11px] font-semibold tracking-[0.24em] text-wine uppercase">
                Sección {String(i + 1).padStart(2, '0')}
              </span>
              <h2 class="mt-1.5 font-serif text-2xl font-semibold text-ink sm:text-3xl">
                {cat.nombre}
              </h2>
            </div>
            <div class="flex items-center gap-4">
              <span class="text-[12px] font-semibold tracking-[0.1em] text-muted uppercase">
                {cat.productos.length}{' '}
                {cat.productos.length === 1 ? 'arreglo' : 'arreglos'}
              </span>
              <a
                href={`/solo-ofrendas/${cat.slug}`}
                class="inline-flex shrink-0 items-center gap-1 text-[12px] font-semibold tracking-[0.1em] text-wine uppercase transition hover:text-wine-hover"
              >
                Ver categoría <svg class="h-3.5 w-3.5" aria-hidden="true"><use href="#i-arrow" /></svg>
              </a>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4 sm:gap-5 md:grid-cols-3 lg:grid-cols-4">
            {cat.productos.map((prod) => (
              <ProductCard
                producto={{
                  id: prod.id,
                  nombre: prod.nombre,
                  precio: prod.precio,
                  imagen: prod.imagen,
                  alt: `${prod.nombre} — Florella`,
                  occasions: [cat.nombre],
                  disponible: prod.disponible,
                }}
              />
            ))}
          </div>
        </div>
      </section>
    ))
  }
</Layout>
