---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCategoriasSoloOfrendas } from '../../data/catalogo.js';

const categorias = await getCategoriasSoloOfrendas();
const total = categorias.reduce((n, cat) => n + cat.productos.length, 0);

const minPrecio = (cat) =>
  cat.productos.reduce((min, p) => (p.precio < min ? p.precio : min), Infinity);
const portada = (cat) => (cat.productos.find((p) => p.imagen) || {}).imagen || null;

const enlaces = categorias.map((cat) => ({
  slug: cat.slug,
  nombre: cat.nombre,
  desde: minPrecio(cat),
  imagen: portada(cat),
}));

const PERSONALIZADO =
  'https://wa.me/528142547600?text=' +
  encodeURIComponent('Hola, quiero un pedido personalizado de Solo Ofrendas.');
---

<Layout
  title="Coronas y arreglos fúnebres en Monterrey · Solo Ofrendas"
  description="Coronas, arreglos fúnebres y canastillas de peregrinación con entrega el mismo día en Monterrey. Pide por WhatsApp."
>
  <!-- Franja de servicio -->
  <section class="border-b border-line bg-ink text-white">
    <div
      class="mx-auto grid max-w-6xl gap-1.5 px-4 py-3 text-center text-[11px] font-semibold tracking-[0.14em] uppercase sm:grid-cols-3 sm:px-6"
    >
      <span>Servicio a Monterrey y área metropolitana</span>
      <span class="sm:text-center">Envío express (3 hrs)</span>
      <span class="sm:text-right">81-4254-7600</span>
    </div>
  </section>

  <!-- Hero -->
  <section
    aria-labelledby="ofrendas-title"
    class="relative overflow-hidden border-b border-line bg-white"
  >
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <img
        src="/imagenes/hero.jpg"
        alt=""
        fetchpriority="high"
        class="h-full w-full object-cover"
      />
      <div
        class="absolute inset-0 bg-gradient-to-r from-white/90 via-white/60 to-white/10"
      >
      </div>
    </div>
    <div class="relative mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-20">
      <div class="flex max-w-2xl flex-col items-start gap-5">
        <span class="text-[11px] font-semibold tracking-[0.24em] text-wine uppercase"
          >Solo Ofrendas</span
        >
        <h1
          id="ofrendas-title"
          class="font-serif text-3xl leading-[1.12] font-semibold tracking-tight text-ink sm:text-4xl lg:text-[3rem]"
        >
          Te acompañamos en cada momento con flores que hablan desde el corazón
        </h1>
        <p class="text-sm leading-relaxed text-muted sm:text-base">
          Comprometidos con tu tranquilidad en momentos difíciles. Arreglos
          fúnebres de alta calidad, diseñados con respeto y empatía.
        </p>
        <a
          href="#catalogo"
          class="inline-flex items-center gap-2 rounded-none bg-wine px-6 py-3 text-[12px] font-semibold tracking-[0.1em] text-white uppercase transition hover:bg-wine-hover"
        >
          Hacer pedido <svg class="h-[15px] w-[15px]" aria-hidden="true"
            ><use href="#i-arrow"></use></svg
          >
        </a>
        <p class="text-[11.5px] text-muted">
          Si requiere factura se agrega el IVA al costo TOTAL del servicio.
        </p>
      </div>
    </div>
  </section>

  <!-- Catálogo: categorías + personalizado -->
  <section
    id="catalogo"
    class="scroll-mt-20 border-b border-line bg-page py-10 sm:py-14"
  >
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <span class="text-[11px] font-semibold tracking-[0.24em] text-wine uppercase"
        >Catálogo</span
      >
      <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
        <h2 class="font-serif text-3xl font-semibold text-ink sm:text-4xl">
          Nuestras ofrendas
        </h2>
        <p
          class="text-[12px] font-semibold tracking-[0.12em] text-muted uppercase"
        >
          {total} arreglos · {categorias.length} categorías
        </p>
      </div>

      <ul class="mt-8 border-t border-line">
        {
          enlaces.map((cat) => (
            <li class="border-b border-line">
              <a href={`#seccion-${cat.slug}`} class="group flex items-center gap-4 py-4">
                {cat.imagen && (
                  <img
                    src={cat.imagen}
                    alt={cat.nombre}
                    loading="lazy"
                    class="h-14 w-14 shrink-0 rounded-none object-cover"
                  />
                )}
                <span class="flex-1 font-serif text-lg text-ink transition group-hover:text-wine">
                  {cat.nombre}
                </span>
                <span class="flex shrink-0 items-center gap-3">
                  <span class="text-[12px] text-muted">
                    Desde {'$' + Number(cat.desde).toLocaleString('es-MX')}
                  </span>
                  <span class="hidden items-center gap-1 text-[11px] font-semibold tracking-[0.1em] text-wine uppercase sm:inline-flex">
                    Ver más
                    <svg class="h-3.5 w-3.5" aria-hidden="true"><use href="#i-arrow" /></svg>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <div
        class="mt-10 flex flex-col items-start justify-between gap-4 border border-line bg-white p-6 sm:flex-row sm:items-center"
      >
        <div>
          <h3 class="font-serif text-xl font-semibold text-ink">
            ¿Necesitas algo personalizado?
          </h3>
          <p class="mt-1 text-sm text-muted">
            Armamos el arreglo a tu medida y combinación de colores.
          </p>
        </div>
        <a
          href={PERSONALIZADO}
          target="_blank"
          rel="noopener"
          class="inline-flex shrink-0 items-center gap-2 rounded-none bg-wine px-6 py-3 text-[12px] font-semibold tracking-[0.1em] text-white uppercase transition hover:bg-wine-hover"
        >
          <svg class="h-4 w-4" aria-hidden="true"
            ><use href="#i-whatsapp"></use></svg
          >
          Pedidos personalizados
        </a>
      </div>
    </div>
  </section>

  <!-- Secciones de productos -->
  {
    categorias.map((cat, i) => (
      <section
        id={`seccion-${cat.slug}`}
        class="scroll-mt-20 border-b border-line bg-page py-10 sm:py-12"
      >
        <div class="mx-auto max-w-6xl px-4 sm:px-6">
          <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
            <div class="flex items-center gap-4">
              {portada(cat) && (
                <img
                  src={portada(cat)}
                  alt={cat.nombre}
                  loading="lazy"
                  class="h-14 w-14 shrink-0 rounded-none object-cover"
                />
              )}
              <div>
                <span class="text-[11px] font-semibold tracking-[0.24em] text-wine uppercase">
                  Sección {String(i + 1).padStart(2, '0')}
                </span>
                <h2 class="mt-1.5 font-serif text-2xl font-semibold text-ink sm:text-3xl">
                  {cat.nombre}
                </h2>
              </div>
            </div>
            <span class="text-[12px] font-semibold tracking-[0.1em] text-muted uppercase">
              {cat.productos.length}{' '}
              {cat.productos.length === 1 ? 'arreglo' : 'arreglos'}
            </span>
          </div>

          <div class="grid grid-cols-2 gap-4 sm:gap-5 md:grid-cols-3 lg:grid-cols-4">
            {cat.productos.map((prod) => (
              <ProductCard
                producto={{
                  id: prod.id,
                  nombre: prod.nombre,
                  precio: prod.precio,
                  imagen: prod.imagen,
                  alt: `${prod.nombre} — Florella`,
                  occasions: [cat.nombre],
                  disponible: prod.disponible,
                  cta: 'Hacer pedido',
                }}
              />
            ))}
          </div>
        </div>
      </section>
    ))
  }
</Layout>
