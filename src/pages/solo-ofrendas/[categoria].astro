---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCategoriasSoloOfrendas } from '../../data/catalogo.js';

export async function getStaticPaths() {
  const categorias = await getCategoriasSoloOfrendas();
  return categorias.map((categoria) => ({
    params: { categoria: categoria.slug },
    props: { categoria },
  }));
}

const { categoria } = Astro.props;
const categorias = await getCategoriasSoloOfrendas();

// Rango del filtro de precio de esta categoría.
const precios = categoria.productos.map((p) => p.precio);
const precioMax = precios.length ? Math.max(...precios) : 0;
const paso = precioMax > 5000 ? 250 : 100;
const tope = Math.max(paso, Math.ceil(precioMax / paso) * paso);
---

<Layout
  title={`${categoria.nombre} · Solo Ofrendas · Florella`}
  description={`${categoria.nombre} — ${categoria.productos.length} arreglos del catálogo Solo Ofrendas de Florella. Entrega en Monterrey.`}
>
  <section class="bg-page py-10 sm:py-14">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <nav aria-label="Ruta" class="text-xs text-muted">
        <a href="/solo-ofrendas" class="transition hover:text-wine">Solo Ofrendas</a>
        <span class="mx-1.5">/</span>
        <span class="text-ink-secondary">{categoria.nombre}</span>
      </nav>

      <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
        <h1
          class="font-serif text-2xl font-semibold text-ink sm:text-3xl lg:text-4xl"
        >
          {categoria.nombre}
        </h1>
        <p class="text-sm text-muted">
          {categoria.productos.length}
          {categoria.productos.length === 1 ? 'artículo' : 'artículos'}
        </p>
      </div>

      <!-- Categorías -->
      <nav
        aria-label="Categorías de Solo Ofrendas"
        class="mt-5 flex flex-wrap gap-1.5"
      >
        {
          categorias.map((cat) => (
            <a
              href={`/solo-ofrendas/${cat.slug}`}
              aria-current={cat.slug === categoria.slug ? 'page' : undefined}
              class:list={[
                'rounded-none px-3 py-1.5 text-[13px] font-medium transition',
                cat.slug === categoria.slug
                  ? 'bg-wine text-white'
                  : 'bg-white text-ink-secondary ring-1 ring-line hover:bg-wine-soft hover:text-wine',
              ]}
            >
              {cat.nombre}
            </a>
          ))
        }
      </nav>

      <!-- Filtros y orden -->
      <div
        class="mt-5 flex flex-col gap-4 border border-line bg-white p-4 sm:flex-row sm:items-end sm:p-5"
      >
        <label
          class="flex flex-col gap-1.5 text-[11px] font-semibold tracking-[0.12em] text-ink-secondary uppercase"
        >
          Ordenar por
          <select
            id="sort"
            class="rounded-none border border-line bg-page px-3 py-2.5 text-sm font-normal tracking-normal text-ink normal-case outline-none transition focus:border-wine focus:ring-1 focus:ring-wine"
          >
            <option value="price-asc" selected>Precio: más barato al más caro</option>
            <option value="price-desc">Precio: más caro al más barato</option>
            <option value="name">Nombre (A–Z)</option>
          </select>
        </label>

        <label
          class="flex flex-1 flex-col gap-1.5 text-[11px] font-semibold tracking-[0.12em] text-ink-secondary uppercase"
        >
          Precio máximo ·
          <span
            id="max-price-label"
            class="font-normal tracking-normal text-ink normal-case"></span>
          <input
            id="max-price"
            type="range"
            min="0"
            max={tope}
            step={paso}
            value={tope}
            class="mt-2 h-1 w-full cursor-pointer appearance-none rounded-none bg-line accent-wine [&::-moz-range-thumb]:h-4 [&::-moz-range-thumb]:w-4 [&::-moz-range-thumb]:rounded-none [&::-moz-range-thumb]:border-0 [&::-moz-range-thumb]:bg-wine [&::-webkit-slider-thumb]:h-4 [&::-webkit-slider-thumb]:w-4 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-none [&::-webkit-slider-thumb]:bg-wine"
          />
        </label>

        <button
          type="button"
          id="clear-filters"
          class="shrink-0 rounded-none border border-line px-5 py-2.5 text-[12px] font-semibold tracking-[0.1em] text-ink uppercase transition hover:border-wine hover:text-wine"
        >
          Limpiar
        </button>
      </div>
      <p
        id="results-count"
        class="mt-3 text-[12px] font-semibold tracking-[0.1em] text-muted uppercase"
      >
      </p>

      <div
        id="product-grid"
        class="mt-6 grid grid-cols-2 gap-4 sm:gap-5 md:grid-cols-3 lg:grid-cols-4"
      >
        {
          categoria.productos.map((prod) => (
            <ProductCard
              producto={{
                id: prod.id,
                nombre: prod.nombre,
                descripcion: prod.descripcion,
                precio: prod.precio,
                imagen: prod.imagen,
                alt: `${prod.nombre} — Florella`,
                occasions: [categoria.nombre],
                disponible: prod.disponible,
              }}
            />
          ))
        }
      </div>

      <div
        id="empty-products"
        hidden
        class="mt-8 border border-line bg-white p-10 text-center"
      >
        <p class="text-sm text-muted">
          No hay arreglos que coincidan con el filtro.
        </p>
        <button
          type="button"
          id="reset-empty"
          class="mt-4 inline-flex items-center gap-2 rounded-none bg-wine px-5 py-2.5 text-[12px] font-semibold tracking-[0.1em] text-white uppercase transition hover:bg-wine-hover"
        >
          Ver todos los arreglos
        </button>
      </div>
    </div>
  </section>
</Layout>
