---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import { getCategoriasFlorella } from "../data/catalogo.js";

const categorias = await getCategoriasFlorella();
const total = categorias.reduce((n, cat) => n + cat.productos.length, 0);
---

<Layout
  title="Florella · Flores para cada ocasión"
  description="Arreglos, bouquets y ofrendas con entrega en Monterrey y zona conurbada. Flores para cumpleaños, aniversarios, condolencias y más."
>
  <!-- Hero Section -->
  <section
    aria-labelledby="hero-title"
    class="relative overflow-hidden border-b border-line bg-white"
  >
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <img
        src="/imagenes/hero.jpg"
        alt=""
        fetchpriority="high"
        class="h-full w-full object-cover"
      />
      <div
        class="absolute inset-0 bg-gradient-to-r from-white/85 via-white/50 to-white/5"
      >
      </div>
    </div>
    <div class="relative mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
      <div class="flex max-w-xl flex-col items-start gap-5">
        <h1
          id="hero-title"
          class="font-serif text-4xl leading-[1.1] font-semibold tracking-tight text-ink sm:text-5xl lg:text-[3.4rem]"
        >
          Flores para<br />cada ocasión
        </h1>
        <p class="text-sm leading-relaxed text-muted sm:text-base">
          Arreglos, bouquets y ofrendas con entrega en Monterrey y zona
          conurbada.<br />
          Cumpleaños, aniversarios, condolencias y todo lo que quieras expresar
          con flores.
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href="#catalogo"
            class="inline-flex items-center gap-2 rounded-none bg-wine px-6 py-3 text-[12px] font-semibold tracking-[0.1em] text-white uppercase transition hover:bg-wine-hover"
          >
            Ver catálogo <svg
              class="h-[15px] w-[15px]"
              aria-hidden="true"><use href="#i-arrow"></use></svg
            >
          </a>
        </div>

        <div class="grid w-full grid-cols-1 gap-4 sm:grid-cols-3">
          <div class="flex items-center gap-3">
            <svg class="h-8 w-8 shrink-0 text-wine" aria-hidden="true"
              ><use href="#i-truck"></use></svg
            >
            <div class="flex flex-col">
              <strong class="text-[13px] font-semibold text-ink"
                >Entrega el mismo día</strong
              >
              <span class="text-xs text-muted">Monterrey y zona conurbada</span>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <svg class="h-8 w-8 shrink-0 text-wine" aria-hidden="true"
              ><use href="#i-leaf"></use></svg
            >
            <div class="flex flex-col">
              <strong class="text-[13px] font-semibold text-ink"
                >Flores frescas</strong
              >
              <span class="text-xs text-muted">Calidad garantizada</span>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <svg class="h-8 w-8 shrink-0 text-wine" aria-hidden="true"
              ><use href="#i-lock"></use></svg
            >
            <div class="flex flex-col">
              <strong class="text-[13px] font-semibold text-ink"
                >Compra segura</strong
              >
              <span class="text-xs text-muted">Atención personalizada</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cabecera del catálogo + navegación por sección -->
  <section id="catalogo" class="scroll-mt-20 bg-page py-10 sm:py-12">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <span class="text-[11px] font-semibold tracking-[0.24em] text-wine uppercase"
        >Catálogo</span
      >
      <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
        <h2 class="font-serif text-3xl font-semibold text-ink sm:text-4xl">
          Nuestras flores
        </h2>
        <p
          class="text-[12px] font-semibold tracking-[0.12em] text-muted uppercase"
        >
          {total} arreglos · {categorias.length} secciones
        </p>
      </div>

      <nav aria-label="Secciones" class="mt-6 flex flex-wrap gap-1.5">
        {
          categorias.map((cat) => (
            <a
              href={`#seccion-${cat.slug}`}
              class="rounded-none border border-line bg-white px-3 py-1.5 text-[12px] font-semibold tracking-[0.06em] text-ink-secondary uppercase transition hover:border-wine hover:text-wine"
            >
              {cat.nombre}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <!-- Secciones -->
  {
    categorias.map((cat, i) => (
      <section
        id={`seccion-${cat.slug}`}
        class="scroll-mt-20 border-t border-line bg-page py-10 sm:py-12"
      >
        <div class="mx-auto max-w-6xl px-4 sm:px-6">
          <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
            <div>
              <span class="text-[11px] font-semibold tracking-[0.24em] text-wine uppercase">
                Sección {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-1.5 font-serif text-2xl font-semibold text-ink sm:text-3xl">
                {cat.nombre}
              </h3>
            </div>
            <span class="text-[12px] font-semibold tracking-[0.1em] text-muted uppercase">
              {cat.productos.length}{' '}
              {cat.productos.length === 1 ? 'arreglo' : 'arreglos'}
            </span>
          </div>

          <div class="grid grid-cols-2 gap-4 sm:gap-5 md:grid-cols-3 lg:grid-cols-4">
            {cat.productos.map((prod) => (
              <ProductCard
                producto={{
                  id: prod.id,
                  nombre: prod.nombre,
                  precio: prod.precio,
                  imagen: prod.imagen,
                  alt: `${prod.nombre} — Florella`,
                  occasions: [cat.nombre],
                  disponible: prod.disponible,
                }}
              />
            ))}
          </div>
        </div>
      </section>
    ))
  }
</Layout>
