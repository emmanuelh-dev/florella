---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import { getCategoriasFlorella, formatearPrecio } from "../data/catalogo.js";

const categorias = await getCategoriasFlorella();
const porNombre = new Map(categorias.map((c) => [c.nombre, c]));

// --- Curaduría del inicio (cambia aquí el orden / lo que se muestra) ---
const ORDEN_SECCIONES = [
  'Lírios',
  'Túlipanes',
  'Girasoles',
  'Bouquet de flores para toda ocasión',
  'Arreglos especiales',
  'Aniversarios & enamorados',
  'Caballeros',
  'OCASIÓN ESPECIAL',
  'CUMPLEAÑOS PACK',
];
const POR_FLOR = ['Girasoles', 'Túlipanes', 'Lírios'];
const POR_OCASION = ['Aniversarios & enamorados', 'OCASIÓN ESPECIAL', 'CUMPLEAÑOS PACK'];

const minPrecio = (cat) =>
  cat.productos.reduce((min, p) => (p.precio < min ? p.precio : min), Infinity);
const portada = (cat) => (cat.productos.find((p) => p.imagen) || {}).imagen || null;

const secciones = ORDEN_SECCIONES.map((n) => porNombre.get(n)).filter(Boolean);
const enlaces = (nombres) =>
  nombres
    .map((n) => porNombre.get(n))
    .filter(Boolean)
    .map((cat) => ({ ...cat, desde: minPrecio(cat), imagen: portada(cat) }));

const grupos = [
  { titulo: 'Por flor', items: enlaces(POR_FLOR) },
  { titulo: 'Por ocasión', items: enlaces(POR_OCASION) },
];
const total = secciones.reduce((n, cat) => n + cat.productos.length, 0);

const PERSONALIZADO =
  'https://wa.me/528142547600?text=' +
  encodeURIComponent('Hola, quiero un pedido personalizado de flores.');

const TESTIMONIOS = [
  {
    texto: 'El arreglo llegó puntual a la capilla y quedó precioso. Muy atentos en todo momento.',
    nombre: 'Cliente · Monterrey',
  },
  {
    texto: 'Pedí por WhatsApp y en dos horas ya estaba entregado. Excelente servicio.',
    nombre: 'Cliente · San Pedro',
  },
  {
    texto: 'Las flores duraron muchísimo y el detalle personalizado quedó tal cual lo imaginaba.',
    nombre: 'Cliente · Guadalupe',
  },
];
---

<Layout
  title="Florella · Flores para cada ocasión"
  description="Arreglos, bouquets y ofrendas con entrega el mismo día en Monterrey y área metropolitana. Pide por flor u ocasión."
>
  <!-- Franja de servicio -->
  <section class="border-b border-line bg-ink text-white">
    <div
      class="mx-auto grid max-w-6xl gap-1.5 px-4 py-3 text-center text-[11px] font-semibold tracking-[0.14em] uppercase sm:grid-cols-3 sm:px-6"
    >
      <span>Servicio a Monterrey y área metropolitana</span>
      <span class="sm:text-center">Envío express (2 hrs)</span>
      <span class="sm:text-right">Envía desde cualquier parte</span>
    </div>
  </section>

  <!-- Hero Section -->
  <section
    aria-labelledby="hero-title"
    class="relative overflow-hidden border-b border-line bg-white"
  >
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <img
        src="/imagenes/hero.jpg"
        alt=""
        fetchpriority="high"
        class="h-full w-full object-cover"
      />
      <div
        class="absolute inset-0 bg-gradient-to-r from-white/85 via-white/50 to-white/5"
      >
      </div>
    </div>
    <div class="relative mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-20">
      <div class="flex max-w-xl flex-col items-start gap-5">
        <h1
          id="hero-title"
          class="font-serif text-4xl leading-[1.1] font-semibold tracking-tight text-ink sm:text-5xl lg:text-[3.4rem]"
        >
          Flores para<br />cada ocasión
        </h1>
        <p class="text-sm leading-relaxed text-muted sm:text-base">
          Arreglos, bouquets y ofrendas con entrega el mismo día en Monterrey y
          área metropolitana.<br />
          Cumpleaños, aniversarios, condolencias y todo lo que quieras expresar
          con flores.
        </p>
        <a
          href="#catalogo"
          class="inline-flex items-center gap-2 rounded-none bg-wine px-6 py-3 text-[12px] font-semibold tracking-[0.1em] text-white uppercase transition hover:bg-wine-hover"
        >
          Ver catálogo <svg
            class="h-[15px] w-[15px]"
            aria-hidden="true"><use href="#i-arrow"></use></svg
          >
        </a>
      </div>
    </div>
  </section>

  <!-- Catálogo: por flor / por ocasión + personalizado -->
  <section
    id="catalogo"
    class="scroll-mt-20 border-b border-line bg-white py-10 sm:py-14"
  >
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <span class="text-[11px] font-semibold tracking-[0.24em] text-wine uppercase"
        >Catálogo</span
      >
      <h2 class="mt-2 font-serif text-3xl font-semibold text-ink sm:text-4xl">
        Explora por flor u ocasión
      </h2>

      <div class="mt-8 grid gap-8 md:grid-cols-2 md:gap-12">
        {
          grupos.map((grupo) => (
            <div>
              <h3 class="text-[12px] font-semibold tracking-[0.18em] text-wine uppercase">
                {grupo.titulo}
              </h3>
              <ul class="mt-3 border-t border-line">
                {grupo.items.map((cat) => (
                  <li class="border-b border-line">
                    <a
                      href={`#seccion-${cat.slug}`}
                      class="group flex items-center gap-4 py-4"
                    >
                      {
                        cat.imagen && (
                          <img
                            src={cat.imagen}
                            alt={cat.nombre}
                            loading="lazy"
                            class="h-14 w-14 shrink-0 rounded-none object-cover"
                          />
                        )
                      }
                      <span class="flex-1 font-serif text-lg text-ink transition group-hover:text-wine">
                        {cat.nombre}
                      </span>
                      <span class="flex shrink-0 items-center gap-3">
                        <span class="text-[12px] text-muted">
                          Desde {'$' + Number(cat.desde).toLocaleString('es-MX')}
                        </span>
                        <span class="hidden items-center gap-1 text-[11px] font-semibold tracking-[0.1em] text-wine uppercase sm:inline-flex">
                          Ver más
                          <svg class="h-3.5 w-3.5" aria-hidden="true"><use href="#i-arrow" /></svg>
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div
        class="mt-10 flex flex-col items-start justify-between gap-4 border border-line bg-page p-6 sm:flex-row sm:items-center"
      >
        <div>
          <h3 class="font-serif text-xl font-semibold text-ink">
            ¿Necesitas algo personalizado?
          </h3>
          <p class="mt-1 text-sm text-muted">
            Armamos el arreglo a tu medida y combinación de colores.
          </p>
        </div>
        <a
          href={PERSONALIZADO}
          target="_blank"
          rel="noopener"
          class="inline-flex shrink-0 items-center gap-2 rounded-none bg-wine px-6 py-3 text-[12px] font-semibold tracking-[0.1em] text-white uppercase transition hover:bg-wine-hover"
        >
          <svg class="h-4 w-4" aria-hidden="true"
            ><use href="#i-whatsapp"></use></svg
          >
          Pedidos personalizados
        </a>
      </div>
    </div>
  </section>

  <!-- Secciones de productos -->
  {
    secciones.map((cat, i) => (
      <section
        id={`seccion-${cat.slug}`}
        class="scroll-mt-20 border-b border-line bg-page py-10 sm:py-12"
      >
        <div class="mx-auto max-w-6xl px-4 sm:px-6">
          <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
            <div class="flex items-center gap-4">
              {
                portada(cat) && (
                  <img
                    src={portada(cat)}
                    alt={cat.nombre}
                    loading="lazy"
                    class="h-14 w-14 shrink-0 rounded-none object-cover"
                  />
                )
              }
              <div>
                <span class="text-[11px] font-semibold tracking-[0.24em] text-wine uppercase">
                  Sección {String(i + 1).padStart(2, '0')}
                </span>
                <h2 class="mt-1.5 font-serif text-2xl font-semibold text-ink sm:text-3xl">
                  {cat.nombre}
                </h2>
              </div>
            </div>
            <span class="text-[12px] font-semibold tracking-[0.1em] text-muted uppercase">
              {cat.productos.length}{' '}
              {cat.productos.length === 1 ? 'arreglo' : 'arreglos'}
            </span>
          </div>

          <div class="grid grid-cols-2 gap-4 sm:gap-5 md:grid-cols-3 lg:grid-cols-4">
            {cat.productos.map((prod) => (
              <ProductCard
                producto={{
                  id: prod.id,
                  nombre: prod.nombre,
                  precio: prod.precio,
                  imagen: prod.imagen,
                  alt: `${prod.nombre} — Florella`,
                  occasions: [cat.nombre],
                  disponible: prod.disponible,
                  cta: 'Hacer pedido',
                }}
              />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <!-- Testimonios -->
  <section class="border-b border-line bg-white py-10 sm:py-14">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <span class="text-[11px] font-semibold tracking-[0.24em] text-wine uppercase"
        >Opiniones</span
      >
      <h2 class="mt-2 font-serif text-3xl font-semibold text-ink sm:text-4xl">
        Lo que opinan nuestros clientes
      </h2>

      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {
          TESTIMONIOS.map((t) => (
            <figure class="border border-line bg-page p-6">
              <div class="flex gap-1 text-wine" aria-label="5 de 5 estrellas">
                {Array.from({ length: 5 }).map(() => (
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.9 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9z" />
                  </svg>
                ))}
              </div>
              <blockquote class="mt-4 text-sm leading-relaxed text-ink-secondary">
                “{t.texto}”
              </blockquote>
              <figcaption class="mt-4 text-[11px] font-semibold tracking-[0.12em] text-muted uppercase">
                {t.nombre}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
