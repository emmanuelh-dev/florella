---
// Tarjeta de producto compartida por toda la tienda (inicio y Solo Ofrendas).
const { producto } = Astro.props;
const {
  id,
  nombre,
  precio,
  imagen = null,
  alt = nombre,
  occasions = [],
  disponible = true,
} = producto;
const precioTexto = '$' + Number(precio).toLocaleString('es-MX') + ' MXN';
---

<article
  data-product
  data-id={id}
  data-name={nombre}
  data-price={precio}
  data-occasions={occasions.join('|')}
  class="group flex flex-col overflow-hidden rounded-none bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl"
>
  <div class="relative aspect-[3/4] overflow-hidden bg-card">
    {
      imagen ? (
        <img
          src={imagen}
          alt={alt}
          loading="lazy"
          class="h-full w-full object-cover transition duration-700 ease-out will-change-transform group-hover:scale-[1.05]"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center text-muted-light">
          <svg class="h-10 w-10" aria-hidden="true"
            ><use href="#i-orchid"></use></svg
          >
        </div>
      )
    }
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/25 via-transparent to-transparent opacity-0 transition group-hover:opacity-100"
    >
    </div>
    <button
      type="button"
      data-favorite={id}
      aria-label={'Guardar ' + nombre + ' en favoritos'}
      aria-pressed="false"
      class="absolute top-3 right-3 inline-flex h-9 w-9 items-center justify-center rounded-none bg-white/90 text-ink shadow-sm backdrop-blur transition hover:text-wine"
    >
      <svg class="h-[18px] w-[18px]" aria-hidden="true"
        ><use href="#i-heart"></use></svg
      >
    </button>
    {
      !disponible && (
        <span class="absolute top-3 left-3 rounded-none bg-ink/85 px-2.5 py-1 text-[11px] font-semibold text-white">
          Agotado
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-4">
    <h3 class="text-[13px] font-semibold text-ink sm:text-sm">{nombre}</h3>
    <p class="mt-1 font-serif text-lg font-semibold text-wine">{precioTexto}</p>
    <button
      type="button"
      data-add={id}
      data-name={nombre}
      data-price={precio}
      data-image={imagen || ''}
      class="mt-3 inline-flex items-center justify-center gap-1.5 rounded-none bg-wine-soft px-4 py-2.5 text-[12px] font-semibold tracking-[0.08em] text-wine uppercase transition hover:bg-wine hover:text-white"
    >
      <svg class="h-4 w-4" aria-hidden="true"><use href="#i-bag"></use></svg>
      Agregar
    </button>
  </div>
</article>
